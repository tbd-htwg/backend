# Prefer backend/docs/gettingstarted/.env (loaded first by scripts/local-dev.sh).
# This file is a fallback if you keep secrets only at the backend root.
#
# Copy to backend/.env.local
JWT_SECRET=replace-with-your-jwt-secret-min-32-chars!!
INTERNAL_SECRET=dev-internal-service-secret
GOOGLE_PROJECT=tbd-cloudappdev
TRIPPLANNING_AUTH_FIREBASE_PROJECT_ID=tbd-cloudappdev
GCP_STORAGE_BUCKET_NAME=tbd-cloudappdev-images-bucket
GCP_IMPERSONATE_SERVICE_ACCOUNT=tripplanning-image-url-sig@tbd-cloudappdev.iam.gserviceaccount.com
