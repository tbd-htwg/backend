# Copy to backend/.env.local (loaded by scripts/local-dev.sh)
JWT_SECRET=replace-with-your-jwt-secret-min-32-chars!!
INTERNAL_SECRET=dev-internal-service-secret
# GCP project with Identity Platform / Firebase (same as ms2 gettingstarted)
GOOGLE_PROJECT=milestone2-tbd-cad
TRIPPLANNING_AUTH_FIREBASE_PROJECT_ID=milestone2-tbd-cad
# Optional: Viator partner API key for real tour data
# VIATOR_API_KEY=
# Optional overrides
# GOOGLE_REGION=europe-west1
# GKE_CLUSTER=tripplanning-gke
# FIRESTORE_EMULATOR_HOST_PORT=0.0.0.0:9090
# MINIKUBE_STOP_ON_USE_GKE=true
# MINIKUBE_MEMORY=24576   # default 24GiB; ES + Redis + 3 services need headroom
