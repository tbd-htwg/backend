<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>com.tripplanning</groupId>
  <artifactId>tripplanning-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>tripplanning-parent</name>
  <description>Trip Planning backend (multi-module)</description>

  <modules>
    <module>tripplanning-common</module>
    <module>tripplanning-trip-service</module>
    <module>tripplanning-social-service</module>
    <module>tripplanning-external-info-service</module>
    <module>tripplanning-platform-service</module>
    <module>tripplanning-customfield-service</module>
    <module>tripplanning-seed-job</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <spring-cloud-gcp.version>5.10.0</spring-cloud-gcp.version>
    <hibernate-search.version>7.0.1.Final</hibernate-search.version>
    <springdoc.version>2.8.9</springdoc.version>
    <cloud-sql-socket-factory.version>1.22.0</cloud-sql-socket-factory.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.tripplanning</groupId>
        <artifactId>tripplanning-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${java.version}</release>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
