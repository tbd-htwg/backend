# Copy to backend/docs/gettingstarted/.env
# Loaded automatically by backend/scripts/local-dev.sh (before backend/.env.local).
#
# JWT_SECRET must be at least 32 characters.
JWT_SECRET=replace-with-your-jwt-secret-min-32-chars!!

# Shared internal header for social-service /internal/** (optional override)
INTERNAL_SECRET=dev-internal-service-secret

# GCP dev project (Identity Platform / Firebase + GCS + Places API)
GOOGLE_PROJECT=tbd-cloudappdev
TRIPPLANNING_AUTH_FIREBASE_PROJECT_ID=tbd-cloudappdev

# GCS image uploads (bucket + signer SA in tbd-cloudappdev; run ./scripts/local-dev.sh setup-gcs-iam once)
GCP_STORAGE_BUCKET_NAME=tbd-test
GCP_IMPERSONATE_SERVICE_ACCOUNT=tripplanning-image-url-sig@tbd-cloudappdev.iam.gserviceaccount.com
# ADC_FILE=${HOME}/.config/gcloud/application_default_credentials.json

# Google Places API (New) — required for /api/v2/external/details/search and place enrichment
# Create in GCP console → APIs & Services → Credentials (project tbd-cloudappdev); enable places.googleapis.com
# GOOGLE_MAPS_API_KEY=

# Optional: Viator partner API key for real tour data in external-info-service
# VIATOR_API_KEY=

# Sample images: deploy skips rsync to gs://…/sample/ by default (~2.8 GiB). Opt in:
# SYNC_SAMPLE_IMAGES=true
# Or run once manually: ./scripts/local-dev.sh sync-sample-images

# Minikube sizing (OpenSearch + 3 services need headroom)
# MINIKUBE_CPUS=4
# MINIKUBE_MEMORY=24576
# MINIKUBE_DRIVER=docker

# Firestore: default is in-cluster Deployment (firestore-emulator:8080).
# Set true only to debug with host gcloud emulator on :9090 instead.
# USE_HOST_FIRESTORE_EMULATOR=false
# FIRESTORE_EMULATOR_HOST_PORT=0.0.0.0:9090

# When switching back to GKE deploy (ms2 / tbd-cloudappdev):
# GOOGLE_PROJECT=tbd-cloudappdev
# GOOGLE_REGION=europe-west1
# GKE_CLUSTER=tripplanning-gke
# MINIKUBE_STOP_ON_USE_GKE=true
